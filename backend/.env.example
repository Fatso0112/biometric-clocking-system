ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Use the PostgreSQL connection string supplied by the hosting platform.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=clocking_management;Username=postgres;Password=replace-me

Jwt__Issuer=ClockingManagement.Api
Jwt__Audience=ClockingManagement.Clients
Jwt__SigningKey=replace-with-a-random-secret-of-at-least-32-characters
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Add one exact frontend origin per array index. Do not include a trailing slash.
Cors__AllowedOrigins__0=https://your-project.vercel.app

Swagger__Enabled=false

# Enable only for the first deployment when no administrator exists, then disable.
SeedAdmin__Enabled=false
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=replace-with-a-strong-temporary-password
