{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "tests/.compiled",
    "rootDir": "src"
  },
  "include": [
    "src/config/featureFlagPolicy.ts",
    "src/navigation/portalNavigation.ts",
    "src/security/routeAccess.ts",
    "src/services/canonicalDomainAdapters.ts",
    "src/services/persistentStore.ts",
    "src/services/sessionPersistence.ts",
    "src/types/canonicalDomain.ts",
    "src/types/navigation.ts",
    "src/types/session.ts",
    "src/services/productionDataCleanup.ts"
  ]
}
